[sqlfluff]
# dbt templater: renders ref(), dbt.* and project macros exactly as dbt does.
# Run from dbt_claims/ (it reads profiles.yml in this directory).
templater = dbt
dialect = duckdb
# Excluded rules, with reasons:
# - ambiguous.column_count / structure.column_order: models list columns in the
#   same order as the Dataform originals, which mixes plain and computed columns.
# - layout.long_lines: sqlfluff measures the RENDERED line, and macros such as
#   dbt.datediff(...) expand on one line.
# - references.keywords: dim_date keeps the Dataform column names year, quarter,
#   month, day (and rpt_claim_frequency keeps `year`), which are keywords.
exclude_rules = ambiguous.column_count, structure.column_order, layout.long_lines, references.keywords

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .
